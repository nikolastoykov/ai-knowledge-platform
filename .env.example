OPENAI_API_KEY=your-openai-api-key
# Set this to a model available to your account with structured outputs and tool calling.
OPENAI_MODEL=your-text-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ai_knowledge
RAG_MIN_SIMILARITY=0.3
RAG_MIN_RELEVANCE=0.5
